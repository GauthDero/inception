[mysqld]
user = mysql #pour ne pas executer en root
pid-file = /run/mysqld/mysqld.pid
basedir = /usr
datadir = /var/lib/mysql #volume persistant
tmpdir = /tmp
lc-messages-dir = /usr/share/mysql
lc-messages = en_US
skip-external-locking # + stable
bind-address = 0.0.0.0 #mariadb ecoute tout -> connexion avec autres containers
character-set-server = utf8mb4
collation-server = utf8mb4_general_ci